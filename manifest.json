{
  "manifest_version": 3,
  "name": "CodeVault – Push to GitHub",
  "version": "1.0.0",
  "description": "Push your solutions from LeetCode, Codeforces, HackerRank & more to GitHub with one click.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://www.hackerrank.com/*",
    "https://atcoder.jp/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content-scripts/leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://codeforces.com/*"],
      "js": ["content-scripts/codeforces.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hackerrank.com/*"],
      "js": ["content-scripts/hackerrank.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://atcoder.jp/*"],
      "js": ["content-scripts/atcoder.js"],
      "run_at": "document_idle"
    }
  ]
}
